From 6889fc2104e5d20899b91e61daf07a7524b2010d Mon Sep 17 00:00:00 2001
From: Hui Tang <tanghui20@huawei.com>
Date: Sat, 22 May 2021 10:44:28 +0800
Subject: crypto: ecdh - fix ecdh-nist-p192's entry in testmgr

From: Hui Tang <tanghui20@huawei.com>

commit 6889fc2104e5d20899b91e61daf07a7524b2010d upstream.

Add a comment that p192 will fail to register in FIPS mode.

Fix ecdh-nist-p192's entry in testmgr by removing the ifdefs
and not setting fips_allowed.

Signed-off-by: Hui Tang <tanghui20@huawei.com>
Signed-off-by: Herbert Xu <herbert@gondor.apana.org.au>
Signed-off-by: Greg Kroah-Hartman <gregkh@linuxfoundation.org>
---
 crypto/ecdh.c    |    1 +
 crypto/testmgr.c |    3 ---
 crypto/testmgr.h |    2 --
 3 files changed, 1 insertion(+), 5 deletions(-)

--- a/crypto/ecdh.c
+++ b/crypto/ecdh.c
@@ -179,6 +179,7 @@ static int ecdh_init(void)
 {
 	int ret;
 
+	/* NIST p192 will fail to register in FIPS mode */
 	ret = crypto_register_kpp(&ecdh_nist_p192);
 	ecdh_nist_p192_registered = ret == 0;
 
--- a/crypto/testmgr.c
+++ b/crypto/testmgr.c
@@ -4920,15 +4920,12 @@ static const struct alg_test_desc alg_te
 		}
 	}, {
 #endif
-#ifndef CONFIG_CRYPTO_FIPS
 		.alg = "ecdh-nist-p192",
 		.test = alg_test_kpp,
-		.fips_allowed = 1,
 		.suite = {
 			.kpp = __VECS(ecdh_p192_tv_template)
 		}
 	}, {
-#endif
 		.alg = "ecdh-nist-p256",
 		.test = alg_test_kpp,
 		.fips_allowed = 1,
--- a/crypto/testmgr.h
+++ b/crypto/testmgr.h
@@ -2364,7 +2364,6 @@ static const struct kpp_testvec curve255
 }
 };
 
-#ifndef CONFIG_CRYPTO_FIPS
 static const struct kpp_testvec ecdh_p192_tv_template[] = {
 	{
 	.secret =
@@ -2404,7 +2403,6 @@ static const struct kpp_testvec ecdh_p19
 	.expected_ss_size = 24
 	}
 };
-#endif
 
 static const struct kpp_testvec ecdh_p256_tv_template[] = {
 	{
