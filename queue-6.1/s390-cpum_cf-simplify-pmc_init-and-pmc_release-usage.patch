From 8249b19d5de93b33c7beb3ab890bbd39a2562e7e Mon Sep 17 00:00:00 2001
From: Sasha Levin <sashal@kernel.org>
Date: Tue, 24 Jan 2023 12:20:55 +0100
Subject: s390/cpum_cf: simplify PMC_INIT and PMC_RELEASE usage

From: Thomas Richter <tmricht@linux.ibm.com>

[ Upstream commit 0d5f0dc83073cd36d1e92bbcbcc3bc046918bc69 ]

Simplify the use of constants PMC_INIT and PMC_RELEASE.

Suggested-by: Heiko Carstens <hca@linux.ibm.com>
Signed-off-by: Thomas Richter <tmricht@linux.ibm.com>
Signed-off-by: Heiko Carstens <hca@linux.ibm.com>
Stable-dep-of: c8b2bb9385d0 ("s390/cpum_cf: Honor hwctr session cpu mask during hotplug")
Signed-off-by: Sasha Levin <sashal@kernel.org>
---
 arch/s390/kernel/perf_cpum_cf.c | 18 +++++++-----------
 1 file changed, 7 insertions(+), 11 deletions(-)

diff --git a/arch/s390/kernel/perf_cpum_cf.c b/arch/s390/kernel/perf_cpum_cf.c
index 0c9d6df2a2294..246e014971bea 100644
--- a/arch/s390/kernel/perf_cpum_cf.c
+++ b/arch/s390/kernel/perf_cpum_cf.c
@@ -507,14 +507,14 @@ static void cpumf_pmu_disable(struct pmu *pmu)
 	cpuhw->flags &= ~PMU_F_ENABLED;
 }
 
-#define PMC_INIT      0
-#define PMC_RELEASE   1
+#define PMC_INIT      0UL
+#define PMC_RELEASE   1UL
 
 static void cpum_cf_setup_cpu(void *flags)
 {
 	struct cpu_cf_events *cpuhw = this_cpu_ptr(&cpu_cf_events);
 
-	switch (*((int *)flags)) {
+	switch ((unsigned long)flags) {
 	case PMC_INIT:
 		memset(&cpuhw->info, 0, sizeof(cpuhw->info));
 		qctri(&cpuhw->info);
@@ -536,9 +536,7 @@ static void cpum_cf_setup_cpu(void *flags)
 /* Initialize the CPU-measurement counter facility */
 static int __kernel_cpumcf_begin(void)
 {
-	int flags = PMC_INIT;
-
-	on_each_cpu(cpum_cf_setup_cpu, &flags, 1);
+	on_each_cpu(cpum_cf_setup_cpu, (void *)PMC_INIT, 1);
 	irq_subclass_register(IRQ_SUBCLASS_MEASUREMENT_ALERT);
 
 	return 0;
@@ -547,9 +545,7 @@ static int __kernel_cpumcf_begin(void)
 /* Release the CPU-measurement counter facility */
 static void __kernel_cpumcf_end(void)
 {
-	int flags = PMC_RELEASE;
-
-	on_each_cpu(cpum_cf_setup_cpu, &flags, 1);
+	on_each_cpu(cpum_cf_setup_cpu, (void *)PMC_RELEASE, 1);
 	irq_subclass_unregister(IRQ_SUBCLASS_MEASUREMENT_ALERT);
 }
 
@@ -938,10 +934,10 @@ static struct pmu cpumf_pmu = {
 	.read	      = cpumf_pmu_read,
 };
 
-static int cpum_cf_setup(unsigned int cpu, int flags)
+static int cpum_cf_setup(unsigned int cpu, unsigned long flags)
 {
 	local_irq_disable();
-	cpum_cf_setup_cpu(&flags);
+	cpum_cf_setup_cpu((void *)flags);
 	local_irq_enable();
 	return 0;
 }
-- 
