 	for (i = 1; i < info->hdr->e_shnum; i++) {
 		shdr = &info->sechdrs[i];
 		switch (shdr->sh_type) {
@@ -1814,12 +1859,6 @@ static int elf_validity_cache_copy(struct load_info *info, int flags)
 			sym_idx = i;
