+
 #define HID_BAT_ABSOLUTESTATEOFCHARGE	0x00850065
 
 #define HID_VD_ASUS_CUSTOM_MEDIA_KEYS	0xff310076
@@ -389,6 +412,12 @@ struct hid_item {
 #define HID_BOOT_PROTOCOL	0
 
