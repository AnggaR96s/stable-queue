From 4204f3d003f9a2618cb755c4ecfbc6c668aaccf3 Mon Sep 17 00:00:00 2001
From: Sasha Levin <sashal@kernel.org>
Date: Wed, 16 Sep 2026 12:32:38 -0400
Subject: Revert "slab: reset slab->obj_ext when freeing and it is
 OBJEXTS_ALLOC_FAIL"

This reverts commit 13c6ff1d4662f28701f80120b15c32b6b3db4bd9.

Signed-off-by: Sasha Levin <sashal@kernel.org>
---
 mm/slub.c | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/mm/slub.c b/mm/slub.c
index 9087fd9a83b72..e2634fe919f67 100644
--- a/mm/slub.c
+++ b/mm/slub.c
@@ -2161,15 +2161,8 @@ alloc_tagging_slab_free_hook(struct kmem_cache *s, struct slab *slab, void **p,
 		return;
 
 	obj_exts = slab_obj_exts(slab);
-	if (!obj_exts) {
-		/*
-		 * If obj_exts allocation failed, slab->obj_exts is set to
-		 * OBJEXTS_ALLOC_FAIL. In this case, we end up here and should
-		 * clear the flag.
-		 */
-		slab->obj_exts = 0;
+	if (!obj_exts)
 		return;
-	}
 
 	for (i = 0; i < objects; i++) {
 		unsigned int off = obj_to_index(s, slab, p[i]);
-- 
2.53.0

