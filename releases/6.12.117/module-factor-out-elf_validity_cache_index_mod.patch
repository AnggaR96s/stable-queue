-				mod_idx = i;
-			}
-			break;
 		}
 	}
 
@@ -2005,55 +2057,8 @@ static int elf_validity_cache_copy(struct load_info *info, int flags)
 	info->index.str = shdr->sh_link;
 	info->strtab = (char *)info->hdr + info->sechdrs[info->index.str].sh_offset;
 
