From ed118607361f35c8fddbaad53a862286a15a9565 Mon Sep 17 00:00:00 2001
From: Sasha Levin <sashal@kernel.org>
Date: Thu, 29 Oct 2026 11:04:41 -0400
Subject: Revert "s390/uv: Don't return 0 from make_hva_secure() if the
 operation was not successful"

This reverts commit cd78dd7fb054945c81d7106a094590be36f0553a.

Signed-off-by: Sasha Levin <sashal@kernel.org>
---
 arch/s390/kernel/uv.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/arch/s390/kernel/uv.c b/arch/s390/kernel/uv.c
index 6cf5025c1f58e..785d396c5fdb2 100644
--- a/arch/s390/kernel/uv.c
+++ b/arch/s390/kernel/uv.c
@@ -393,11 +393,8 @@ int make_hva_secure(struct mm_struct *mm, unsigned long hva, struct uv_cb_header
 	folio_walk_end(&fw, vma);
 	mmap_read_unlock(mm);
 
-	if (rc == -E2BIG || rc == -EBUSY) {
+	if (rc == -E2BIG || rc == -EBUSY)
 		rc = s390_wiggle_split_folio(mm, folio, rc == -E2BIG);
-		if (!rc)
-			rc = -EAGAIN;
-	}
 	folio_put(folio);
 
 	return rc;
-- 
2.53.0

