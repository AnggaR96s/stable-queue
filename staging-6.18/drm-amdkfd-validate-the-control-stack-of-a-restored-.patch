 .../gpu/drm/amd/amdkfd/kfd_mqd_manager_v11.c  |  3 ++
 .../gpu/drm/amd/amdkfd/kfd_mqd_manager_v9.c   |  3 ++
 .../gpu/drm/amd/amdkfd/kfd_mqd_manager_vi.c   |  3 ++
 .../amd/amdkfd/kfd_process_queue_manager.c    | 30 +++++++++++++------
